# Copy this file to ".env" and adjust as needed.
# The backend reads these via pydantic-settings (see backend/app/config.py).

# Where the SQLite database lives. Relative paths resolve against the repo root.
DATABASE_PATH=data/truckapp.db

# Seed data loaded into the (empty) pois table on first startup.
DATA_SEED_FILE=data/a1_poi.json

# Comma-separated list of origins allowed by CORS.
# In production set this to your real frontend origin(s) only.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080

# Uvicorn bind settings.
HOST=0.0.0.0
PORT=8080

# Logging: debug | info | warning | error
LOG_LEVEL=info
